{
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "target": "ES2022",
    "types": ["vitest/globals", "vite/client"]
  },
  "include": ["src", "test", "vite.config.ts"]
}
